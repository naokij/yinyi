# Git ignore for YinYi Project

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Project specific - DO NOT commit these
data/*.db
data/*.db-journal
backend/data/
backend/exports/
exports/*.png
exports/*.pdf
photos/*
!photos/.gitkeep
!photos/README.md

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*.local

# OS
Thumbs.db
.DS_Store
*.tmp

# Docker
*.pid
